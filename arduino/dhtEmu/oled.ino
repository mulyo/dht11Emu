// ============================================================
// ADC READ MANUAL
// ============================================================
static void adc_init(void) {
    // Vref = AVcc (5V), left adjust OFF
    ADMUX  = (1 << REFS0);
    // Prescaler 128 => 16MHz/128 = 125 kHz, enable ADC
    ADCSRA = (1 << ADEN) | (1 << ADPS2) | (1 << ADPS1) | (1 << ADPS0);
}

static uint16_t adc_read(uint8_t ch) {
    ch &= 0x07;
    ADMUX = (ADMUX & 0xF8) | ch;
    ADCSRA |= (1 << ADSC);       // start
    while (ADCSRA & (1 << ADSC)); // wait
    return ADC;
}
