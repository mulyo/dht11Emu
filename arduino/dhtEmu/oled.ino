
// ============================================================
// I2C SOFTWARE BIT-BANGING (manual, tanpa Wire)
// ============================================================
static void i2c_delay(void) {
    // ~4 us @ 16 MHz => 400 kHz cukup untuk SSD1306
    _delay_us(4);
}

static void i2c_sda_lo(void) {
    DDRC  |= (1 << SDA_PIN);   // SDA as output
    PORTC &= ~(1 << SDA_PIN);  // SDA LOW
}

static void i2c_sda_hi(void) {
    DDRC  &= ~(1 << SDA_PIN);  // SDA as input (open-drain, pull-up external)
    PORTC |= (1 << SDA_PIN);   // enable pull-up just in case
}

static void i2c_scl_lo(void) {
    DDRC  |= (1 << SCL_PIN);
    PORTC &= ~(1 << SCL_PIN);
}

static void i2c_scl_hi(void) {
    DDRC  &= ~(1 << SCL_PIN);
    PORTC |= (1 << SCL_PIN);
}

static void i2c_start(void) {
    i2c_sda_hi();
    i2c_scl_hi();
    i2c_delay();
    i2c_sda_lo();
    i2c_delay();
    i2c_scl_lo();
    i2c_delay();
}

static void i2c_stop(void) {
    i2c_sda_lo();
    i2c_delay();
    i2c_scl_hi();
    i2c_delay();
    i2c_sda_hi();
    i2c_delay();
}

// Kirim 1 byte I2C, return ACK status (ignore for OLED)
static uint8_t i2c_write_byte(uint8_t data) {
    for (uint8_t i = 0; i < 8; i++) {
        if (data & 0x80) i2c_sda_hi();
        else             i2c_sda_lo();
        i2c_delay();
        i2c_scl_hi();
        i2c_delay();
        i2c_scl_lo();
        data <<= 1;
    }
    // Clock pulse for ACK (master release SDA)
    i2c_sda_hi();
    i2c_delay();
    i2c_scl_hi();
    i2c_delay();
    i2c_scl_lo();
    return 0;
}

// ============================================================
// OLED SSD1306 128x64 DRIVER (I2C, tanpa library)
// ============================================================
#define OLED_CMD  0x00
#define OLED_DATA 0x40

static void oled_send(uint8_t type, uint8_t val) {
    i2c_start();
    i2c_write_byte((OLED_ADDR << 1) | 0); // write
    i2c_write_byte(type);                 // Co=0, D/C#
    i2c_write_byte(val);
    i2c_stop();
}

static void oled_cmd(uint8_t c)   { oled_send(OLED_CMD, c); }
static void oled_data(uint8_t d)  { oled_send(OLED_DATA, d); }

