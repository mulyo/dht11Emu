static void oled_set_pos(uint8_t page, uint8_t col) {
    oled_cmd(0xB0 | (page & 0x07));           // Set page address
    oled_cmd(0x00 | (col & 0x0F));            // Set lower col
    oled_cmd(0x10 | ((col >> 4) & 0x0F));     // Set upper col
}

static void oled_clear(void) {
    for (uint8_t p = 0; p < 8; p++) {
        oled_set_pos(p, 0);
        for (uint8_t c = 0; c < 128; c++) {
            oled_data(0x00);
        }
    }
}

static void oled_init(void) {
    // Init sequence for SSD1306 128x64
    _delay_ms(20);
    oled_cmd(0xAE); // Display OFF
    oled_cmd(0xD5); // Set display clock div
    oled_cmd(0x80);
    oled_cmd(0xA8); // Set multiplex
    oled_cmd(0x3F); // 64 MUX
    oled_cmd(0xD3); // Set display offset
    oled_cmd(0x00);
    oled_cmd(0x40); // Set start line (0)
    oled_cmd(0x8D); // Charge pump
    oled_cmd(0x14); // Enable charge pump
    oled_cmd(0x20); // Memory mode
    oled_cmd(0x00); // Horizontal addressing
    oled_cmd(0xA1); // Segment remap (mirror)
    oled_cmd(0xC8); // COM scan dir (remap)
    oled_cmd(0xDA); // COM pins config
    oled_cmd(0x12);
    oled_cmd(0x81); // Contrast
    oled_cmd(0xCF);
    oled_cmd(0xD9); // Pre-charge period
    oled_cmd(0xF1);
    oled_cmd(0xDB); // VCOMH deselect
    oled_cmd(0x40);
    oled_cmd(0xA4); // Entire display on (A4=follow RAM, A5=all on)
    oled_cmd(0xA6); // Normal display (A6=normal, A7=inverse)
    oled_cmd(0xAF); // Display ON
    oled_clear();
}

// Cetak 1 karakter (5 kolom + 1 spasi)
static void oled_putc(char ch) {
    if (ch < 32 || ch > 126) ch = 32;
    uint8_t idx = ch - 32;
    for (uint8_t i = 0; i < 5; i++) {
        uint8_t b = pgm_read_byte(&font5x7[idx][i]);
        oled_data(b);
    }
    oled_data(0x00); // spasi 1 kolom
}

static void oled_puts(const char *s) {
    while (*s) oled_putc(*s++);
}

// Print angka desimal 2 digit
static void oled_put2(uint8_t v) {
    if (v > 99) v = 99;
    oled_putc('0' + (v / 10));
    oled_putc('0' + (v % 10));
}

